    transition: box-shadow .15s ease, transform .15s ease;
  }
  .card:before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--grad-brand); opacity: .55; }
  .card h3 { font-size: 12.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); margin: 0 0 14px; font-weight: 800; }
  .card p { line-height: 1.7; color: var(--text); font-size: 14.5px; margin: 0 0 10px; }
  .card p:last-child { margin-bottom: 0; }

  /* hero */
  .hero {
    padding: 34px 32px;
    margin: -4px 0 8px;
    border-radius: 22px;
    background: var(--grad-soft);
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .hero:before {
    content: '';
    position: absolute; width: 320px; height: 320px; border-radius: 50%;
    background: radial-gradient(circle, rgba(37,99,235,.18), transparent 70%);
    top: -140px; right: -100px; filter: blur(4px);
  }
  .hero:after {
    content: '';
    position: absolute; width: 260px; height: 260px; border-radius: 50%;
    background: radial-gradient(circle, rgba(124,58,237,.14), transparent 70%);
    bottom: -120px; left: -80px; filter: blur(4px);
  }
  .hero-name {
    font-size: 42px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.02em;
    background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent;
    position: relative;
  }
  .hero-title { font-size: 17px; color: var(--text); font-weight: 700; margin: 0 0 16px; position: relative; }
  .hero-lede { font-size: 15.5px; color: var(--text-dim); line-height: 1.75; max-width: 720px; margin: 0 0 22px; position: relative; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; position: relative; }
  .cta { padding: 12px 22px; border-radius: 11px; font-size: 13.5px; font-weight: 700; cursor: pointer; border: 1px solid transparent; transition: transform .12s ease, box-shadow .12s ease; }
  .cta.primary { background: var(--grad-brand); color: #fff; box-shadow: 0 8px 20px rgba(37,99,235,.28); }
  .cta.primary:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(37,99,235,.36); }
  .cta.secondary { background: #fff; color: var(--text); border-color: var(--border); }
  .cta.secondary:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }

  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin: 26px 0 6px; position: relative; }
  .stat-card {
    background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px;
    box-shadow: var(--shadow-sm); transition: transform .12s ease, box-shadow .12s ease;
  }
  .stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .stat-card .num {
    font-size: 26px; font-weight: 800;
    background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stat-card .lbl { font-size: 12px; color: var(--text-dim); margin-top: 2px; font-weight: 600; }

  /* timeline */
  .timeline { border-left: 2px solid var(--border); margin-left: 6px; padding-left: 26px; }
  .tl-item { position: relative; margin-bottom: 28px; }
  .tl-item:before {
    content: ''; position: absolute; left: -32px; top: 4px; width: 13px; height: 13px; border-radius: 50%;
    background: var(--grad-brand); border: 3px solid #fff; box-shadow: 0 0 0 2px var(--border), 0 2px 6px rgba(37,99,235,.3);
  }
  .tl-role { font-size: 16px; font-weight: 800; margin: 0; }
  .tl-meta { font-size: 12.5px; color: var(--accent-2); margin: 2px 0 10px; font-weight: 600; }
  .tl-item ul { margin: 0; padding-left: 18px; }
  .tl-item li { font-size: 13.5px; line-height: 1.65; color: var(--text); margin-bottom: 4px; }

  /* skills */
  .skill-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .skill-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 13px; padding: 16px 18px;
    box-shadow: var(--shadow-sm); transition: transform .12s ease, box-shadow .12s ease;
  }
  .skill-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .skill-card .name { font-size: 13.5px; font-weight: 800; margin-bottom: 6px; }
  .skill-card .desc { font-size: 12px; color: var(--text-dim); margin-bottom: 10px; line-height: 1.5; }
  .dots { display: flex; gap: 4px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .dot.filled { background: var(--grad-brand); }

  ul.feature-list, ol.demo-list { margin: 0; padding-left: 0; list-style: none; }
  ul.feature-list li, ol.demo-list li { display: flex; gap: 10px; padding: 8px 0; font-size: 14px; line-height: 1.55; border-bottom: 1px solid var(--panel-2); }
  ul.feature-list li:last-child, ol.demo-list li:last-child { border-bottom: none; }
  ul.feature-list li:before { content: "✓"; color: var(--green); font-weight: 700; flex-shrink: 0; }
  ol.demo-list { counter-reset: step; }
  ol.demo-list li:before { counter-increment: step; content: counter(step); flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--accent-2); color: #fff; font-size: 11px; display: flex; align-items: center; justify-content: center; font-weight: 700; }

  /* course modules */
  .module-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 14px;
    padding: 20px 24px; margin-bottom: 14px; box-shadow: var(--shadow-sm);
    border-left: 3px solid transparent;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .module-card:hover { border-left-color: var(--accent-2); box-shadow: var(--shadow-md); transform: translateX(2px); }
  .module-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .module-head .mnum { font-size: 11px; font-weight: 800; color: var(--accent); letter-spacing: .06em; text-transform: uppercase; }
  .module-head h4 { font-size: 16.5px; margin: 4px 0 0; }
  .module-dur { font-size: 12px; color: var(--text-dim); background: var(--panel-2); padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
  .module-topics { margin: 12px 0 0; padding-left: 18px; }
  .module-topics li { font-size: 13.5px; color: var(--text); line-height: 1.6; margin-bottom: 3px; }
  .module-link { display: inline-block; margin-top: 10px; font-size: 12.5px; color: var(--accent-2); cursor: pointer; font-weight: 700; }
  .module-link:hover { text-decoration: underline; }
  .level-header .badge { font-size: 11px; padding: 5px 13px; }

  /* flow diagram (reused for use cases) */
  .flow-diagram { display: flex; align-items: center; flex-wrap: wrap; gap: 0; }
  .flow-step {
    background: #fff; border: 1px solid var(--border); border-top: 2px solid var(--accent-2);
    border-radius: 10px; padding: 12px 16px; font-size: 12.5px; font-weight: 700; text-align: center;
    white-space: pre-line; line-height: 1.35; min-width: 110px; color: var(--text);
    box-shadow: var(--shadow-sm); margin: 4px 0;
  }
  .flow-arrow { color: var(--accent-2); font-size: 18px; padding: 0 10px; flex-shrink: 0; font-weight: 700; }

  table.tools-table { width: 100%; border-collapse: collapse; margin-top: 4px; }
  table.tools-table td, table.tools-table th { padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 13.5px; text-align: left; }
  table.tools-table th { color: var(--text-dim); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  table.tools-table td:first-child { color: var(--accent); font-weight: 600; white-space: nowrap; width: 160px; }

  .file-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .file-chip {
    background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; cursor: pointer;
    font-size: 12.5px; font-family: "SFMono-Regular", Consolas, monospace; color: var(--text);
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .file-chip:hover { border-color: var(--accent-2); color: var(--accent-2); transform: translateY(-2px); box-shadow: var(--shadow-sm); background: #fff; }

  .code-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: #282c34; border: 1px solid var(--border); border-bottom: none; border-radius: 10px 10px 0 0; font-family: Consolas, monospace; font-size: 12.5px; color: #abb2bf; }
  .copy-btn { background: var(--accent-2); color: #fff; border: none; border-radius: 6px; padding: 5px 12px; font-size: 11.5px; cursor: pointer; font-weight: 600; }
  .copy-btn:hover { opacity: .85; }
  pre.code-block { margin: 0; border-radius: 0 0 10px 10px; max-height: 68vh; overflow: auto; border: 1px solid var(--border); }
  pre.code-block code { font-size: 13px; line-height: 1.55; padding: 18px !important; }

  .home-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-top: 8px; }
  .home-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
  }
  .home-card:before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--grad-brand); transform: scaleX(0); transform-origin: left; transition: transform .2s ease; }
  .home-card:hover { border-color: transparent; transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .home-card:hover:before { transform: scaleX(1); }
  .home-card .n { font-size: 11px; color: var(--accent-2); font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .home-card h4 { margin: 6px 0 8px; font-size: 15px; }
  .home-card .badges { margin: 10px 0 0; }
  .home-card .badge { font-size: 10.5px; padding: 3px 9px; }

  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 14px; margin-top: 6px; }
  .contact-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 16px; padding: 24px; text-align: center;
    box-shadow: var(--shadow-sm); transition: transform .15s ease, box-shadow .15s ease;
  }
  .contact-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .contact-card .ic {
    font-size: 22px; margin: 0 auto 10px; width: 46px; height: 46px; border-radius: 12px;
    background: var(--grad-brand); color: #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 16px rgba(37,99,235,.25);
  }
  .contact-card a { color: var(--accent-2); font-weight: 700; text-decoration: none; font-size: 14px; }
  .contact-card a:hover { text-decoration: underline; }
  .contact-card .lbl { font-size: 11.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; font-weight: 700; }

  .note-box { background: linear-gradient(135deg, #fffaf0, #fef3e2); border: 1px dashed #e8c98a; border-radius: 12px; padding: 14px 16px; font-size: 12.5px; color: #8a5a00; margin-top: 18px; }

  /* why train with me */
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
