<style>
  :root {
    --bg: #f4f6fb;
    --panel: #ffffff;
    --panel-2: #f1f4f9;
    --border: #e3e7f0;
    --text: #161b26;
    --text-dim: #667085;
    --accent: #0f766e;
    --accent-light: #e6f4f2;
    --accent-2: #2563eb;
    --accent-3: #7c3aed;
    --green: #15803d;
    --amber: #b45309;
    --sidebar-w: 300px;
    --grad-brand: linear-gradient(135deg, #0f766e 0%, #2563eb 55%, #7c3aed 100%);
    --grad-soft: linear-gradient(135deg, rgba(15,118,110,.08), rgba(37,99,235,.08) 55%, rgba(124,58,237,.08));
    --shadow-sm: 0 1px 2px rgba(16,24,40,.04);
    --shadow-md: 0 4px 14px rgba(16,24,40,.06);
    --shadow-lg: 0 12px 32px rgba(16,24,40,.10);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(1100px 500px at 100% -10%, rgba(37,99,235,.10), transparent 60%),
      radial-gradient(900px 500px at -10% 0%, rgba(15,118,110,.10), transparent 55%),
      var(--bg);
    color: var(--text);
    display: flex;
    height: 100vh;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- Sidebar ---------- */
  #sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    background: var(--panel);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 24px rgba(16,24,40,.04);
    position: relative;
    z-index: 2;
  }

  /* Draggable divider between sidebar and main content */
  #resizer {
    width: 6px; flex-shrink: 0; cursor: col-resize; position: relative; z-index: 3;
    background: transparent;
  }
  #resizer:hover #resizer-handle, #resizer.dragging #resizer-handle { opacity: 1; background: var(--accent-2); }
  #resizer-handle {
    position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; transform: translateX(-50%);
    background: var(--border); opacity: 0; transition: opacity .15s ease, background .15s ease;
    border-radius: 3px;
  }
  #resizer.dragging { background: rgba(37,99,235,.06); }
  body.resizing { cursor: col-resize !important; user-select: none; }
  body.resizing #main { pointer-events: none; }
  #sidebar:before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--grad-brand);
  }
  #sidebar-header {
    padding: 26px 18px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--grad-soft);
  }
  #avatar {
    width: 46px; height: 46px; border-radius: 14px;
    background: var(--grad-brand);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 17px; flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(37,99,235,.30);
  }
  #sidebar-header h1 { font-size: 15px; margin: 0 0 2px; color: var(--text); font-weight: 800; }
  #sidebar-header p { margin: 0; font-size: 11.5px; color: var(--text-dim); font-weight: 600; letter-spacing: .01em; }

  #tree { padding: 10px 8px 24px; flex: 1; }

  .tree-item {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 10px; border-radius: 9px; cursor: pointer;
    font-size: 13.5px; color: var(--text); user-select: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    border-left: 2px solid transparent;
    transition: background .12s ease, color .12s ease;
  }
  .tree-item:hover { background: var(--panel-2); }
  .tree-item.active {
    background: linear-gradient(90deg, rgba(15,118,110,.10), rgba(37,99,235,.06));
    color: var(--accent); font-weight: 700;
    border-left: 2px solid var(--accent);
  }
  .tree-item .chevron { display: inline-block; width: 12px; transition: transform .15s ease; color: var(--text-dim); flex-shrink: 0; font-size: 10px; }
  .tree-item .chevron.open { transform: rotate(90deg); }
  .tree-item .icon { flex-shrink: 0; font-size: 14px; }
  .tree-children { margin-left: 20px; border-left: 1px solid var(--border); padding-left: 8px; display: none; }
  .tree-children.open { display: block; }
  .tree-children .tree-item { font-size: 12.5px; color: var(--text-dim); padding: 7px 10px; }
  .tree-children .tree-item.active { color: var(--accent); background: var(--accent-light); }

  #sidebar-footer { padding: 14px 18px; border-top: 1px solid var(--border); font-size: 11px; color: var(--text-dim); }

  /* ---------- Main ---------- */
  #main { flex: 1; overflow-y: auto; position: relative; }
  #topbar {
