// ---------- Client-side encrypted gates (Premium Content + Project code files) ----------
// Neither the premium topics nor the use-case file source ever reach the
// browser in plaintext — DATA.premiumLocked and DATA.useCasesLocked each
// hold an AES-256-GCM ciphertext produced at build time, both keyed by the
// SAME PIN. Typing the correct PIN re-derives the key (PBKDF2, 100k
// iterations) in-browser via the Web Crypto API and decrypts it. Nothing is
// sent anywhere and nothing is written to disk/localStorage. This is a real
// cryptographic gate, not a cosmetic one, but it's still a static file: the
// ciphertext, salt, and iv are visible to anyone who views source, so a weak
// PIN could in principle be brute-forced offline. Use a real passphrase, not
// a 4-digit number, if this matters.
let premiumUnlocked = null;   // decrypted premium categories array, this page load only
let codeFilesUnlocked = null; // decrypted useCases array (with file content), this page load only

function b64ToBytes(b64) {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return bytes;
}

async function decryptLockedBlob(locked, pin) {
  const salt = b64ToBytes(locked.salt);
  const iv = b64ToBytes(locked.iv);
  const payload = b64ToBytes(locked.data);
  const enc = new TextEncoder();
  const keyMaterial = await crypto.subtle.importKey('raw', enc.encode(pin), { name: 'PBKDF2' }, false, ['deriveKey']);
  const key = await crypto.subtle.deriveKey(
    { name: 'PBKDF2', salt, iterations: 100000, hash: 'SHA-256' },
    keyMaterial,
    { name: 'AES-GCM', length: 256 },
    false,
    ['decrypt']
  );
  const decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, payload);
  return JSON.parse(new TextDecoder().decode(decrypted));
}

async function tryUnlockPremium(pin) {
  try {
    premiumUnlocked = await decryptLockedBlob(DATA.premiumLocked, pin);
    return true;
  } catch (e) {
    return false;
  }
}

async function tryUnlockCodeFiles(pin) {
  try {
    codeFilesUnlocked = await decryptLockedBlob(DATA.useCasesLocked, pin);
    return true;
  } catch (e) {
    return false;
  }
}

