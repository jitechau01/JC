  h3.section-title:before { content: ''; width: 5px; height: 20px; border-radius: 3px; background: var(--grad-brand); display: inline-block; }
  .subtitle { color: var(--text-dim); font-size: 15px; margin: 0 0 26px; line-height: 1.6; }

  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 24px; }
  .badge { background: var(--accent-light); border: 1px solid var(--border); color: var(--accent); padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; }
  .badge.blue { background: #eaf1ff; color: var(--accent-2); }
  .badge.amber { background: #fef3e2; color: var(--amber); }
  .badge.brand { background: var(--grad-brand); color: #fff; border: none; box-shadow: 0 3px 10px rgba(37,99,235,.25); }

  .card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 16px;
