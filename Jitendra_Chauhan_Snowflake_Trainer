  #breadcrumb { font-size: 12.5px; color: var(--text-dim); font-weight: 600; }
  #breadcrumb b { color: var(--accent-2); }
  #share-btn {
    background: #fff; border: 1px solid var(--border); color: var(--text-dim);
    font-size: 12px; font-weight: 700; padding: 7px 14px; border-radius: 999px; cursor: pointer;
    transition: border-color .15s, color .15s; white-space: nowrap;
  }
  #share-btn:hover { border-color: var(--accent-2); color: var(--accent-2); }
  #content { padding: 30px 40px 90px; max-width: 1080px; }

  h2.page-title { font-size: 28px; margin: 0 0 8px; font-weight: 800; letter-spacing: -.01em; }
  h3.section-title {
